{
    "name": "@zeitport/ignidex",
    "version": "0.3.0",
    "description": "A simple, link-only start page with grouping and visual highlights.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && npm run lint && vite build",
        "preview": "vite preview",
        "lint": "oxlint --config ./.oxlintrc.json",
        "lint:fix": "oxlint --config ./.oxlintrc.json --fix",
        "tsc": "tsc"
    },
    "author": "Chris Zeitport <chris@zeitport.com>",
    "license": "ISC",
    "dependencies": {
        "@mdi/js": "^7.4.47",
        "lit": "^3.2.1",
        "nanoid": "^5.1.6"
    },
    "imports": {
        "#elements": "./src/elements/index.ts",
        "#utils/*": "./src/utils/*",
        "#inject": "./src/core/injector.ts",
        "#models/*": "./src/model/*",
        "#core/*": "./src/core/*"
    },
    "devDependencies": {
        "typescript": "~5.6.2",
        "oxlint": "^1.37.0",
        "vite": "^6.0.3"
    }
